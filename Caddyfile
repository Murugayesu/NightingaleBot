{
	# Caddy's admin API can rewrite live config; nothing here needs it.
	admin off

	# Let's Encrypt account e-mail (only used when SITE_ADDRESS is a real domain).
	email {$ACME_EMAIL:admin@localhost}

	# Proxies in FRONT of Caddy whose X-Forwarded-For may be believed, e.g. a
	# cloud load balancer's subnet or Cloudflare's ranges. Default: none, so
	# Caddy is the edge and the socket address is the client. Without this
	# behind a load balancer, every user would share one rate-limit bucket.
	servers {
		trusted_proxies static {$CADDY_TRUSTED_PROXIES:127.0.0.1/32}
	}
}

# SITE_ADDRESS decides whether TLS is on:
#   ":80"                  plain HTTP: the server's IP address or localhost (today)
#   "nursing.example.org"  Caddy obtains and renews a certificate automatically;
#                          then also set AUTH_COOKIE_SECURE=true in .env
{$SITE_ADDRESS::80} {
	header {
		-Server
		Permissions-Policy "geolocation=(), camera=(), microphone=()"
	}

	# HSTS only over HTTPS (browsers must ignore it on plain HTTP; RFC 6797 §8.1).
	# No 'preload': submitting to the preload list is effectively irreversible.
	@secure protocol https
	header @secure Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# Cap request bodies at the edge (the app enforces the same limits before
	# reading a body). Uploads: MAX_UPLOAD_SIZE_BYTES (50 MiB) plus form overhead;
	# everything else is small JSON.
	@upload path /api/v1/documents/upload
	request_body @upload {
		max_size {$CADDY_MAX_UPLOAD_SIZE:55MB}
	}
	@not_upload not path /api/v1/documents/upload
	request_body @not_upload {
		max_size 1MB
	}

	# ------------------------------------------------------------ the API
	# The API sets its own security headers (CSP, X-Frame-Options); they are
	# left untouched here.
	@api path /api/* /health /docs /docs/* /openapi.json /local/*
	handle @api {
		reverse_proxy api:8000 {
			# Overwrite, never append. {client_ip} is the real client: the socket
			# address, or the forwarded address when the request came through a
			# trusted proxy above. The app believes this header only because it
			# arrives from a private network (TRUSTED_PROXY_NETWORKS), i.e. Caddy.
			header_up X-Forwarded-For {client_ip}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Admin-API-Key {$ADMIN_API_KEY:admin:admin@123}

			# Deliver SSE tokens immediately instead of buffering the whole answer.
			flush_interval -1
		}
	}

	# ------------------------------------------------------- the web app
	handle {
		root * /srv

		# One strict policy for the whole app: only its own scripts, styles,
		# images and API; never framed by another site.
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
			X-Frame-Options DENY
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
		}

		# Build output in /assets has content hashes in its names: cache it for
		# a year. Everything else (index.html) must be revalidated, so a new
		# release reaches browsers at once.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@other not path /assets/*
		header @other Cache-Control "no-cache"

		# Client-side routes (/c/<id>, /settings, /admin ...) all load the app.
		try_files {path} /index.html
		encode zstd gzip
		file_server
	}

	log {
		output stdout
		format console
		level INFO
	}
}
