# NursingBot configuration. Copy to .env and fill in the blanks.
# Every setting is documented in src/nursing_bot/config.py.
# Generate the secrets with:  python -m nursing_bot.cli gen-secrets

# ---------------------------------------------------------------- core
ENVIRONMENT=production             # production | development (relaxes secret checks; local only)
LOG_LEVEL=INFO
LOG_FORMAT=text                    # text | json (json for log shippers)
INGESTION_MODE=inline              # inline (no worker) | queue (docker compose sets this)
# empty = same-origin only (the web app and the API share one address)
CORS_ALLOWED_ORIGINS=
# Image tag for docker compose. Build each release under a new tag so the
# previous images stay available for a rollback.
APP_VERSION=2.0.0

# ---------------------------------------------------- secrets (CHANGE ALL)
ADMIN_API_KEY=admin:admin@123
SESSION_SECRET=dev-session-secret-change-me
POSTGRES_PASSWORD=postgres
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# ------------------------------------------------------------ public edge
# ":80" = plain HTTP on the server's IP address or localhost (no domain yet).
# A domain name here makes Caddy fetch a TLS certificate; then also set
# AUTH_COOKIE_SECURE=true below.
SITE_ADDRESS=:80
ACME_EMAIL=admin@example.org
CADDY_TRUSTED_PROXIES=127.0.0.1/32   # load balancer / CDN CIDRs in front of Caddy, if any

# -------------------------------------------------------- user accounts
SIGNUP_ENABLED=true
# false while the app is served over plain HTTP; true as soon as HTTPS works
AUTH_COOKIE_SECURE=false
AUTH_SESSION_DAYS=30               # sign-in lasts this long after the last visit
PASSWORD_MIN_LENGTH=10
LOGIN_RATE_LIMIT=10/minute         # per IP address
SIGNUP_RATE_LIMIT=5/hour           # per IP address
LOGIN_MAX_FAILURES=5               # wrong passwords in a row before a pause
LOGIN_LOCKOUT_MINUTES=15
USER_CHAT_RATE_LIMIT=30/minute
USER_DAILY_TOKEN_QUOTA=200000      # LLM tokens per account per day (0 = unlimited)
GLOBAL_DAILY_TOKEN_CAP=0           # LLM tokens per day for everyone together (0 = no cap)
CONVERSATION_RETENTION_DAYS=0      # delete chats inactive this long (0 = keep)
CONVERSATION_SUMMARY_BATCH=6       # older turns are summarised in batches of this size
MAX_RECENT_CONTEXT_TURNS=3         # earlier turns used to understand follow-ups

# ----------------------------------------------------- guests (no account)
GUEST_CHAT_ENABLED=true
CHAT_RATE_LIMIT=20/minute
SESSION_CREATE_RATE_LIMIT=10/hour
CHAT_REQUIRE_SESSION=true
SESSION_TTL_SECONDS=86400
SESSION_TOKEN_BUDGET=50000         # LLM tokens per guest session
ENABLE_DATABASE_CHAT_HISTORY=false # also keep guest chats on the server (PII-redacted)
CHAT_HISTORY_RETENTION_DAYS=30

# ---------------------------------------------------------- organisation
KNOWLEDGE_BASE_NAME="TNNMC Nursing Knowledge Base"
KNOWLEDGE_AUTHORITY_NAME="Tamil Nadu Nurses and Midwives Council"
KNOWLEDGE_AUTHORITY_SHORT_NAME=TNNMC
KNOWLEDGE_CONTACT_URL=https://www.tamilnadunursingcouncil.com/contact
DOMAIN_SYNONYMS_JSON={}            # e.g. {"GNM": "General Nursing and Midwifery (GNM)"}

# ---------------------------------------------------------- answer router
# Labelled general-knowledge answers for general nursing questions that the
# official documents do not cover. false = documents only, as in 1.0.
GENERAL_ANSWERS_ENABLED=true

# ------------------------------------------------- database (local runs)
# docker compose builds DATABASE_URL from POSTGRES_* itself.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nursing_bot

# ------------------------------------------------------- object storage
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET_NAME=nursing-documents
BACKUP_BUCKET_NAME=nursing-backups
DOCUMENTS_BACKUP_BUCKET_NAME=nursing-documents-backup
S3_REGION=us-east-1

# -------------------------------------------------- AI models (LiteLLM)
# Pin a specific model: a router alias such as "auto" may pick a different
# model for each request, so answers change from one ask to the next.
LLM_MODEL=openai/gpt-4o-mini
LLM_API_KEY=
# set to use a LiteLLM proxy or any OpenAI-compatible server
LLM_BASE_URL=
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
EMBEDDING_MODEL=openai/text-embedding-3-small
# defaults to LLM_API_KEY
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSIONS=1536          # <= 1536; smaller vectors are zero-padded
EMBEDDING_BATCH_SIZE=32
EMBEDDING_RATE_LIMIT_RETRIES=6     # ingestion waits out provider rate limits
WORKER_CONCURRENCY=2               # use 1 with free-tier providers

RERANK_ENABLED=false
RERANK_MODEL=cohere/rerank-v3.5
RERANK_API_KEY=
RERANK_BASE_URL=
RERANK_TOP_K=5

# -------------------------------------------- chunking and retrieval
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
CONTEXTUAL_HEADERS_ENABLED=false   # one LLM call per chunk at ingestion; measure first
RETRIEVAL_TOP_K=8
RRF_K=60
# 0.30 suits OpenAI embeddings; use 0.50 with gemini-embedding-001 (measured).
# Re-tune with: python -m nursing_bot.cli eval retrieval
GATE_THRESHOLD_SIMILARITY=0.30
GATE_THRESHOLD_RERANK=0.50
CITATION_MIN_COVERAGE=0.5

# ------------------------------------------------------- observability
PHOENIX_ENABLED=true
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:4318/v1/traces
PHOENIX_PROJECT_NAME=nursing-bot-rag
PHOENIX_ENABLE_AUTH=false           # Phoenix UI login (it is only bound to 127.0.0.1)
# PHOENIX_SECRET=                  # 32+ chars; needed only with PHOENIX_ENABLE_AUTH=true (see docker-compose.yml)
# system key from the Phoenix UI, when auth is on
PHOENIX_API_KEY=

# -------------------------------------------------------------- backups
BACKUP_RETENTION_DAYS=7
# never prune below this many good dumps, however old
BACKUP_KEEP_MIN=3
# Off-site copy of the database dumps AND the uploaded documents:
# https://KEY:SECRET@host (empty = the MinIO on this same machine, which does
# not survive losing the machine's disk).
BACKUP_TARGET_URL=
BACKUP_INTERVAL_SECONDS=86400
